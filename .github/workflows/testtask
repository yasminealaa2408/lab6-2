import unittest
from task_manager import TaskManager

class TestTaskManager(unittest.TestCase):
    def setUp(self):
        self.manager = TaskManager()

    def test_add_task(self):
        self.manager.add_task("Test Task")
        self.assertEqual(self.manager.get_task_count(), 1)

    def test_add_empty_task(self):
        self.manager.add_task("")
        self.manager.add_task("   ")
        self.assertEqual(self.manager.get_task_count(), 0)

    def test_complete_task(self):
        self.manager.add_task("Test Task")
        self.manager.complete_task(1)
        self.assertTrue(self.manager.tasks[0].is_completed())

    def test_remove_task(self):
        self.manager.add_task("Test Task")
        self.manager.remove_task(1)
        self.assertEqual(self.manager.get_task_count(), 0)

if __name__ == "__main__":
    unittest.main()
